<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0;net8.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.7.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.14" />
    <PackageReference Include="xunit.v3" Version="4.0.2" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="System.Linq.AsyncEnumerable" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <!-- The package leaves out the runtime's message signer, so its tests compile it here. -->
    <Compile Include="../../src/BackMarketSeller/Runtime/MessageSigner.cs" Link="Runtime/MessageSigner.cs" />
    <ProjectReference Include="../../src/BackMarketSeller/BackMarketSeller.csproj" />
  </ItemGroup>

</Project>
