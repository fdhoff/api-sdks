<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0;net8.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.2" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="System.Linq.AsyncEnumerable" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../../../../../toolchain/conformance/fixtures/webhooks/hmac-sha256.json" Link="webhooks/hmac-sha256.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../../../conformance/webhooks/mercury-signature.json" Link="webhooks/mercury-signature.json" CopyToOutputDirectory="PreserveNewest" />
    <ProjectReference Include="../../src/MercuryBanking/MercuryBanking.csproj" />
  </ItemGroup>

</Project>
