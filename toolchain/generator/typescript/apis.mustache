{{/imports}}
import type * as models from '../models/index.js';
import { Resource, type FileInput, type Operation, type RequestOptions } from '../runtime/index.js';

{{#operations}}
{{#operation}}
const {{nickname}}: Operation = {
  id: '{{operationIdOriginal}}',
  method: '{{httpMethod}}',
  path: '{{{path}}}',
  resource: '{{vendorExtensions.x-sdk-resource}}',
  name: '{{vendorExtensions.x-sdk-method}}',
  params: [
{{#pathParams}}
    { wire: '{{baseName}}', name: '{{paramName}}', location: 'path' },
{{/pathParams}}
{{#queryParams}}
    { wire: '{{baseName}}', name: '{{paramName}}', location: 'query' },
{{/queryParams}}
{{#formParams}}
    { wire: '{{baseName}}', name: '{{paramName}}', location: 'form' },
{{/formParams}}
  ],
{{#bodyParam}}
  hasBody: true,
{{/bodyParam}}
{{#vendorExtensions.x-sdk-returns-json}}
  returnsJson: true,
{{/vendorExtensions.x-sdk-returns-json}}
{{^vendorExtensions.x-sdk-returns-json}}
{{#returnType}}
  returnsText: true,
{{/returnType}}
{{/vendorExtensions.x-sdk-returns-json}}
{{#vendorExtensions.x-sdk-iterator}}
  iterator: '{{vendorExtensions.x-sdk-iterator}}',
{{/vendorExtensions.x-sdk-iterator}}
{{#vendorExtensions.x-sdk-paging.next_link}}
  paging: { style: 'next_link', items: '{{items}}', link: '{{link}}', params: [{{#params}}'{{.}}', {{/params}}] },
{{/vendorExtensions.x-sdk-paging.next_link}}
{{#vendorExtensions.x-sdk-paging.offset}}
  paging: { style: 'offset', items: '{{items}}', total: '{{total}}', offset: '{{offset}}' },
{{/vendorExtensions.x-sdk-paging.offset}}
};

{{/operation}}
export const OPERATIONS: readonly Operation[] = [
{{#operation}}
  {{nickname}},
{{/operation}}
];

export class {{classname}} extends Resource {
{{#operation}}
  /** {{vendorExtensions.x-sdk-summary}} */
  {{vendorExtensions.x-sdk-method}}{{>partial_sdk_args}}: Promise<{{{returnType}}}{{^returnType}}void{{/returnType}}> {
    return this.call{{>partial_sdk_call}};
  }

{{#vendorExtensions.x-sdk-iterator}}
  /** Iterate every item across all pages. */
  {{vendorExtensions.x-sdk-iterator}}{{>partial_sdk_args}}: AsyncGenerator<models.{{vendorExtensions.x-sdk-items}}, void, undefined> {
    return this.paginate{{>partial_sdk_call}};
  }

{{/vendorExtensions.x-sdk-iterator}}
{{/operation}}
}
